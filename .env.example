# -------------------------------------------------------
# NEXT_PUBLIC_API_URL
#   Points the browser to the Next.js proxy route.
#   Keep this as /api/proxy — do NOT change it.
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=/api/proxy

# -------------------------------------------------------
# BACKEND_URL  (server-side only, never sent to browser)
#   The real backend the proxy forwards requests to.
#   Set this in Vercel → Project Settings → Environment Variables.
#   Examples:
#     Local LAN:         http://192.168.20.160:8090
#     Cloudflare tunnel: https://xxxx.trycloudflare.com
#     ngrok:             https://xxxx.ngrok-free.app
#     Public server:     https://api.yoursite.com
# -------------------------------------------------------
BACKEND_URL=http://192.168.20.160:8090
