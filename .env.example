# API Configuration
# Points the browser to the Next.js proxy route (works in both dev and Vercel)
NEXT_PUBLIC_API_URL=/api/proxy

# Real backend URL — used server-side by the proxy only, never exposed to the browser
# In dev: your local network address
# On Vercel: set this in the Vercel environment variables dashboard
BACKEND_URL=http://192.168.20.160:8090
